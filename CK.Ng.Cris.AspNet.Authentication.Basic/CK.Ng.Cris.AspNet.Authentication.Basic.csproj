<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>The Basic login form (user name and password) of CK.Ng.Cris.AspNet.Authentication: it sends the IBasicLoginCommand.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CK.IO.Authentication.Basic" Version="3.0.0-0.cris-auth.0.ci.38" />
    <!-- The endpoint that serves this form executes the Basic login (same origin). -->
    <PackageReference Include="CK.Cris.Authentication.Basic" Version="3.0.0-0.cris-auth.0.ci.75" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CK.Ng.Cris.AspNet.Authentication\CK.Ng.Cris.AspNet.Authentication.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="MSBuild/CK.Ng.Cris.AspNet.Authentication.Basic.targets">
      <Pack>true</Pack>
      <PackagePath>buildTransitive\CK.Ng.Cris.AspNet.Authentication.Basic.targets</PackagePath>
    </Content>
  </ItemGroup>
</Project>
