<Project>

  <Target Name="AddPreserveCKNgCrisAspNetAuthenticationPasskeyGeneratedFile" BeforeTargets="BeforeCompile;CoreCompile" Inputs="$(MSBuildAllProjects)" Outputs="$(IntermediateOutputPath)CK.Ng.Cris.AspNet.Authentication.Passkey.AutoAttributes.g.cs">
    <PropertyGroup>
      <GeneratedFilePath>$(IntermediateOutputPath)CK.Ng.Cris.AspNet.Authentication.Passkey.AutoAttributes.g.cs</GeneratedFilePath>
    </PropertyGroup>
    <ItemGroup>
      <Compile Include="$(GeneratedFilePath)" />
      <FileWrites Include="$(GeneratedFilePath)" />
    </ItemGroup>
    <WriteLinesToFile Lines="[assembly: CK.Setup.PreserveAssemblyReferenceAttribute(typeof(CK.Ng.Cris.AspNet.Authentication.Passkey.NgCrisAuthenticationPasskeyPackage))]" File="$(GeneratedFilePath)" WriteOnlyWhenDifferent="true" Overwrite="true" />
  </Target>

</Project>
